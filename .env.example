# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# On CAI the project environment variables hold these instead. Placeholders only: this repo is public.

# CDW Impala (CDP workload user, LDAP)
OGX_IMPALA_USER=<workload-user>
OGX_IMPALA_PASSWORD=<workload-password>

# Atlas / Ranger through the data lake Knox gateway (same workload user)
OGX_WORKLOAD_USER=<workload-user>
OGX_WORKLOAD_PASSWORD=<workload-password>

# Cloudera AI workbench, API v2
OGX_CAI_HOST=https://ml-xxxx.<env>.cloudera.site
OGX_CAI_API_KEY=<API v2 key: User Settings > API Keys>

# Data Visualization API key (the instance signs users in with SAML)
OGX_VIZ_API_KEY=<data-visualization-api-key>

# CDE virtual cluster (the CLI profile is ~/.cde/config.yaml)
OGX_CDE_VCLUSTER_ENDPOINT=https://<vc>.cde-<id>.<env>.cloudera.site/dex/api/v1
OGX_DL_CRN=<data lake crn>

# Kafka (Streams Messaging Data Hub): SASL_SSL PLAIN with the workload user
OGX_KAFKA_BOOTSTRAP=<broker0>:9093,<broker1>:9093,<broker2>:9093
OGX_KAFKA_SECURITY_PROTOCOL=SASL_SSL
OGX_KAFKA_SASL_MECHANISM=PLAIN
OGX_KAFKA_USER=<workload-user>
OGX_KAFKA_PASSWORD=<workload-password>
OGX_KAFKA_CA_PEM=<path to the environment root CA, PEM: cdp environments get-root-certificate>
OGX_SCHEMA_REGISTRY_URL=https://<datahub-master>/<datahub>/cdp-proxy-api/schema-registry/api/v1
OGX_SMM_API_URL=https://<datahub-master>/<datahub>/cdp-proxy-api/smm-api

# Local dev Kafka instead (scripts/local_kafka.sh): no auth
# OGX_KAFKA_BOOTSTRAP=localhost:9092
# OGX_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Offline run on synthetic frames with the stub embedder
# OGX_CONFIG_OVERLAY=config/ci.yaml
HF_HOME=.hf_cache
OGX_HF_TOKEN=<hugging-face-read-token>

# GitHub Actions secrets (repo Settings > Secrets and variables > Actions), not project variables:
# CAI_URL, CAI_API_KEY, CAI_PROJECT_ID

