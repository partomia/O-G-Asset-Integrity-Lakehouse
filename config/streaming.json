{
  "_comment": "Kafka topics, the producer and the two CDE streaming jobs (standard library json).",
  "topics": {
    "telemetry": {"name": "ogx.sensor.telemetry", "partitions": 6, "replication": 3, "retention_hours": 168},
    "alarm": {"name": "ogx.scada.alarm", "partitions": 3, "replication": 3, "retention_hours": 168},
    "control": {"name": "ogx.control", "partitions": 1, "replication": 3, "retention_hours": 168}
  },
  "nifi": {
    "_comment": "NiFi flow (nifi/deploy_flow.py). Its output topic is kept out of 'topics' so the bronze stream does not ingest the routed copies.",
    "out_topic": {"name": "ogx.alarm.priority", "partitions": 3, "replication": 3, "retention_hours": 168},
    "api": "https://federal-nifi-management0.federal.dp5i-5vkq.cloudera.site/federal-nifi/cdp-proxy-api/nifi-app/nifi-api",
    "registry_api": "https://federal-nifi-management0.federal.dp5i-5vkq.cloudera.site/federal-nifi/cdp-proxy-api/nifi-registry-app/nifi-registry-api",
    "registry_client": "Default NiFi Registry Client",
    "registry_bucket": "ogx-flows",
    "process_group": "OGX - SCADA Alarm Router",
    "flow_name": "ogx-scada-alarm-router",
    "ssl_context_service": "rsingh Truststore-only NiFi SSL Context Service",
    "schema_registry_url": "https://federal-kafka-master0.federal.dp5i-5vkq.cloudera.site/federal-kafka/cdp-proxy-api/schema-registry/api/v1",
    "kafka_bootstrap": "federal-kafka-corebroker0.federal.dp5i-5vkq.cloudera.site:9093,federal-kafka-corebroker1.federal.dp5i-5vkq.cloudera.site:9093,federal-kafka-corebroker2.federal.dp5i-5vkq.cloudera.site:9093",
    "consumer_group": "ogx-nifi-alarm-router",
    "priority_rule": "priority = '1' OR alarm_type IN ('HIHI', 'STUCK')",
    "landing_dir": "s3a://federal-buk-574bcea0/data/IB/rsingh_ogx/landing/nifi/scada_alarm",
    "quarantine_dir": "s3a://federal-buk-574bcea0/data/IB/rsingh_ogx/landing/nifi/quarantine/scada_alarm",
    "position": [0, 1400]
  },
  "producer": {
    "tags": 200,
    "interval_s": 5,
    "live_rate_msgs_s": 40,
    "late_fraction": 0.01,
    "late_seconds": [120, 480],
    "out_of_order_fraction": 0.02,
    "stuck_tag": "VI-112B.PV",
    "unit_change_tag": "PI-105A.PV",
    "unit_change_after_minutes": 600
  },
  "spark": {
    "kafka_package": "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.4",
    "trigger_seconds": 60,
    "watermark": "10 minutes",
    "windows": ["1 minute", "15 minutes"],
    "stuck_windows": 3,
    "min_readings_per_window": {"1 minute": 2, "15 minutes": 24},
    "starting_offsets": "earliest",
    "max_offsets_per_trigger": 200000
  },
  "units": {"bar_to_psi": 14.5038},
  "thresholds": {
    "pressure_psi": {"high": 1450.0},
    "temperature_c": {"high": 180.0},
    "vibration_mm_s": {"high": 7.1},
    "wall_loss_mm_y": {"high": 0.5}
  },
  "threshold_overrides": {"PI-W": 2500.0}
}
